# --- Unreal Engine build products / caches ---
/Binaries/
/Intermediate/
/DerivedDataCache/
/Saved/
/Build/
/Plugins/*/Binaries/
/Plugins/*/Intermediate/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
/.vs/
/.vscode/
/.idea/
*.code-workspace
Makefile
CMakeLists.txt
compile_commands.json

# --- Generated from a local Mobile Forces install by Tools/mfport ---
# These are derived from the original game's copyrighted data and must never be
# committed to the public repository. Re-create them with `Tools/mfport/mfport.py all`.
/Content/MFImported/
/Content/MFMaps/Generated/
/Tools/mfport/work/
# converted community maps (cleared for the game, but large and re-creatable) and the textures
# built from Tools/mfport/overrides
/Content/Maps/
/Content/MF/Community/
/Content/MF/Replacements/

# --- Template content kept locally as placeholders only ---
/Content/Developers/
/Content/Collections/

# --- Python ---
__pycache__/
*.pyc
/Tools/mfport/mfport.toml

# --- Epic template content (UE EULA: not for public redistribution); local placeholders only ---
/Content/Characters/
/Content/LevelPrototyping/

# --- Converted from SourceArt / generated by Tools/artgen (re-create with artgen.py) ---
/Tools/artgen/out/
# imported music keeps the raw PCM (tens of MB): re-import from SourceArt instead of committing
/Content/MF/Music/

# --- Content plugins built from a local Mobile Forces install (Tools/mfport): only the
# descriptor and README are public; Content/ is generated ---
/Plugins/*/Content/
/Plugins/*/*/Binaries/
/Plugins/*/*/Intermediate/
